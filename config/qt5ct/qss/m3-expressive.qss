/* Auto-generated Material Design 3 Expressive Qt Stylesheet (scheme-content, dark) */
QWidget {
    background-color: #141317;
    color: #e6e1e6;
    selection-background-color: #594981;
    selection-color: #f9f1ff;
}
QMainWindow, QDialog {
    background-color: #141317;
}
QMenu, QComboBox QAbstractItemView {
    background-color: #2b292d;
    color: #e6e1e6;
    border: 1px solid #49454f;
    border-radius: 20px;
    padding: 8px;
}
QMenu::item {
    padding: 8px 18px;
    border-radius: 14px;
    margin: 2px 4px;
}
QMenu::item:selected {
    background-color: #594981;
    color: #f9f1ff;
}
QPushButton, QToolButton {
    background-color: #2b292d;
    color: #e6e1e6;
    border: 1px solid #49454f;
    border-radius: 18px;
    padding: 7px 18px;
    font-weight: 600;
}
QPushButton:hover, QToolButton:hover {
    background-color: #4f485f;
    color: #eee3ff;
    border-color: #ccc2de;
}
QPushButton:pressed, QPushButton:checked, QToolButton:checked {
    background-color: #594981;
    color: #f9f1ff;
    border-radius: 12px;
    border-color: #d0bdfd;
}
QPushButton:default {
    background-color: #d0bdfd;
    color: #36275c;
    border: none;
}
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background-color: #363438;
    color: #e6e1e6;
    border: 1px solid #49454f;
    border-radius: 16px;
    padding: 3px 10px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus {
    border: 2px solid #d0bdfd;
}
QTabWidget::pane {
    border: 1px solid #49454f;
    border-radius: 20px;
    background-color: #1c1b1f;
    padding: 6px;
}
QTabBar::tab {
    background-color: transparent;
    color: #cac4d0;
    border-radius: 16px;
    padding: 8px 16px;
    margin: 2px 4px;
    font-weight: 600;
}
QTabBar::tab:selected {
    background-color: #4f485f;
    color: #eee3ff;
}
QListView, QTreeView, QTableView {
    background-color: #1c1b1f;
    border: 1px solid #49454f;
    border-radius: 20px;
    padding: 6px;
    outline: none;
}
QListView::item, QTreeView::item {
    border-radius: 14px;
    padding: 6px 10px;
}
QListView::item:selected, QTreeView::item:selected {
    background-color: #4f485f;
    color: #eee3ff;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}
QScrollBar::handle:vertical {
    background: #948f9a;
    border-radius: 5px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover {
    background: #d0bdfd;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0px;
    width: 0px;
}
QToolTip {
    background-color: #e6e1e6;
    color: #323034;
    border: none;
    border-radius: 12px;
    padding: 6px 10px;
}
