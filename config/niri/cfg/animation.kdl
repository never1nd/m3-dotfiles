// ────────────── Material Design 3 Expressive Motion Physics (Zero Backjump) ──────────────
// Critically damped MD3E Spatial Springs (damping-ratio=1.0):
//   Fast, responsive, buttery deceleration with ZERO overshoot / ZERO backjump!

animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=560 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=720 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=760 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=760 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0005
    }
    screenshot-ui-open {
        duration-ms 180
        curve "ease-out-expo"
    }

    // Material Design 3 Expressive Emphasized Decelerate Window Open (zero overshoot / zero backjump)
    window-open {
        duration-ms 250
        curve "linear"
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float t = clamp(niri_clamped_progress, 0.0, 1.0);
                // Smooth M3 Emphasized Decelerate curve: monotonic [0..1], zero bounce
                float ease = 1.0 - pow(1.0 - t, 3.6);

                float scale = mix(0.92, 1.0, ease);
                float y_offset = (1.0 - ease) * 0.020;

                vec2 coords = (coords_geo.xy - vec2(0.5)) / scale + vec2(0.5);
                coords.y -= y_offset;

                if (coords.x < 0.0 || coords.x > 1.0 || coords.y < 0.0 || coords.y > 1.0) {
                    return vec4(0.0);
                }
                vec3 coords_tex = niri_geo_to_tex * vec3(coords, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);

                float alpha = smoothstep(0.0, 0.30, t);
                return color * alpha;
            }
        "
    }

    // Material Design 3 Expressive Fast Exit (monotonic, zero backjump)
    window-close {
        duration-ms 175
        curve "ease-out-cubic"
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = 1.0 - clamp(niri_clamped_progress, 0.0, 1.0);
                float scale = mix(0.92, 1.0, p);
                float y_offset = (1.0 - p) * -0.016;

                vec2 coords = (coords_geo.xy - vec2(0.5)) / scale + vec2(0.5);
                coords.y -= y_offset;

                if (coords.x < 0.0 || coords.x > 1.0 || coords.y < 0.0 || coords.y > 1.0) {
                    return vec4(0.0);
                }
                vec3 coords_tex = niri_geo_to_tex * vec3(coords, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);
                return color * p;
            }
        "
    }
}
