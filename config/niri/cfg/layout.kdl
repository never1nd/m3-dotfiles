// ────────────── Material Design 3 Expressive Layout ──────────────
layout {
    gaps 10
    center-focused-column "never"
    background-color "transparent"

    default-column-width {
        proportion 0.5
    }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.85
    }

    focus-ring {
        width 3
    }

    shadow {
        on
        softness 30
        spread 2
        offset x=0 y=8
        color "#00000058"
    }

    tab-indicator {
        hide-when-single-tab
        place-within-column
        gap 6
        width 5
        length total-proportion=0.45
        position "left"
        gaps-between-tabs 6
        corner-radius 8
    }

    struts {}
}
