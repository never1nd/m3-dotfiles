// Auto-generated Material Design 3 Expressive tokens (scheme-content, dark)
layout {
    focus-ring {
        active-color   "#d0bdfd"
        inactive-color "#363438"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d0bdfd"
        inactive-color "#363438"
        urgent-color   "#ffb4ab"
    }

    tab-indicator {
        active-color   "#d0bdfd"
        inactive-color "#4f485f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d0bdfd66"
    }
}

overview {
    zoom 0.54
    backdrop-color "#0f0e11"
    workspace-shadow {
        softness 48
        spread 6
        offset x=0 y=12
        color "#00000080"
    }
}

recent-windows {
    highlight {
        active-color "#d0bdfdff"
        urgent-color "#ffb4abff"
    }
}
