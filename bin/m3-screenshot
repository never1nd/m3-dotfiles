#!/usr/bin/env python3
import argparse
import datetime
import json
import pathlib
import subprocess
import sys
import time

HOME = pathlib.Path.home()
OUT_DIR = HOME / "Изображения/Screenshots"
COLORS_JSON = HOME / ".config/quickshell/colors.json"

def load_colors():
    try:
        d = json.loads(COLORS_JSON.read_text())
        return (
            d.get("primary", "#d0bdfd").lstrip("#"),
            d.get("primary_container", "#594981").lstrip("#"),
            d.get("surface_container_lowest", "#0f0d12").lstrip("#"),
        )
    except Exception:
        return "d0bdfd", "594981", "0f0d12"

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("mode", choices=["region", "screen", "window"])
    ap.add_argument("--delay", type=int, default=0)
    args = ap.parse_args()

    OUT_DIR.mkdir(parents=True, exist_ok=True)
    # Wait briefly so ScreenshotPopup finishes closing cleanly before capture
    time.sleep(max(0.24, float(args.delay)))

    ts = datetime.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    outfile = OUT_DIR / f"Screenshot-{ts}.png"

    if args.mode == "window":
        subprocess.run(["niri", "msg", "action", "screenshot-window"], check=False)
        return

    if args.mode == "region":
        prim, pcont, surf = load_colors()
        res = subprocess.run(
            [
                "slurp",
                "-d",
                "-b", f"{surf}80",
                "-c", f"{prim}ff",
                "-s", f"{pcont}30",
                "-B", f"{surf}cc",
                "-F", "Roboto Flex",
                "-w", "2",
            ],
            text=True,
            capture_output=True,
        )
        geom = res.stdout.strip()
        if res.returncode != 0 or not geom:
            return
        subprocess.run(["grim", "-g", geom, str(outfile)], check=True)
    else:
        subprocess.run(["grim", str(outfile)], check=True)

    # Copy to Wayland clipboard (automatically indexed by cliphist!)
    if outfile.exists():
        with outfile.open("rb") as f:
            subprocess.run(["wl-copy", "--type", "image/png"], stdin=f, check=False)
        subprocess.run(
            [
                "notify-send",
                "-a", "Скриншот M3",
                "-i", str(outfile),
                "Скриншот сохранён и скопирован",
                outfile.name,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

if __name__ == "__main__":
    main()
