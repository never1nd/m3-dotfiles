#!/usr/bin/env python3
"""Fetch synced LRC (or plain) lyrics via LRCLIB with smart track cleanup & local cache."""
import hashlib
import json
import pathlib
import re
import sys
import urllib.parse
import urllib.request

CACHE_DIR = pathlib.Path.home() / ".cache/m3-lyrics"
CACHE_DIR.mkdir(parents=True, exist_ok=True)


def clean_str(s: str) -> str:
    s = s or ""
    # Strip bracketed/parenthesized tags like (Official Video), [PV], (In-Game), (Sped Up)
    s = re.sub(r"[\(\[\{][^)\]\}]*(official|video|audio|lyric|pv|mv|in-game|sped|slowed|reverb|remaster|hd|4k|hq|live|instrumental)[^)\]\}]*[\)\]\}]", "", s, flags=re.I)
    s = re.sub(r"【[^】]*】", "", s)
    s = re.sub(r"\s+", " ", s).strip(" -–—·|")
    return s


def parse_lrc(lrc_text: str):
    lines = []
    for raw in lrc_text.splitlines():
        matches = list(re.finditer(r"\[(\d+):(\d+(?:\.\d+)?)\]", raw))
        if not matches:
            continue
        text = re.sub(r"\[(\d+):(\d+(?:\.\d+)?)\]", "", raw).strip()
        if not text:
            continue
        for m in matches:
            sec = int(m.group(1)) * 60 + float(m.group(2))
            lines.append({"time": round(sec, 2), "text": text})
    lines.sort(key=lambda x: x["time"])
    return lines


def http_json(url: str):
    req = urllib.request.Request(url, headers={"User-Agent": "M3-Expressive-Desktop/1.0"})
    with urllib.request.urlopen(req, timeout=6) as resp:
        return json.loads(resp.read().decode("utf-8", errors="replace"))


def pick_result(item: dict):
    if not item:
        return None
    if item.get("syncedLyrics"):
        parsed = parse_lrc(item["syncedLyrics"])
        if parsed:
            return {"synced": True, "lines": parsed, "instrumental": False}
    if item.get("plainLyrics"):
        plain = [{"time": -1, "text": l.strip()} for l in item["plainLyrics"].splitlines() if l.strip()]
        if plain:
            return {"synced": False, "lines": plain, "instrumental": False}
    if item.get("instrumental"):
        return {"synced": False, "lines": [], "instrumental": True}
    return None


def main():
    artist = sys.argv[1] if len(sys.argv) > 1 else ""
    title = sys.argv[2] if len(sys.argv) > 2 else ""

    # If title contains "Artist - Song" and artist is empty or generic, split it
    if " - " in title and (not artist or artist.lower() in ("telegram desktop", "chromium", "firefox", "zen", "pear desktop")):
        parts = title.split(" - ", 1)
        artist = parts[0].strip()
        title = parts[1].strip()

    c_artist = clean_str(artist)
    c_title = clean_str(title)
    if not c_title:
        print(json.dumps({"synced": False, "lines": [], "instrumental": False}))
        return

    key = hashlib.sha1(f"{c_artist.lower()}||{c_title.lower()}".encode()).hexdigest()
    cache_file = CACHE_DIR / f"{key}.json"
    if cache_file.exists():
        print(cache_file.read_text())
        return

    result = None
    # 1) Exact /api/get when artist & title known
    if c_artist:
        try:
            q = urllib.parse.urlencode({"artist_name": c_artist, "track_name": c_title})
            result = pick_result(http_json(f"https://lrclib.net/api/get?{q}"))
        except Exception:
            pass

    # 2) Fallback /api/search with artist + title, then title only
    if result is None:
        queries = [f"{c_artist} {c_title}".strip(), c_title]
        for qstr in queries:
            try:
                q = urllib.parse.urlencode({"q": qstr})
                arr = http_json(f"https://lrclib.net/api/search?{q}")
                if isinstance(arr, list) and arr:
                    # Prefer entries with syncedLyrics
                    arr.sort(key=lambda x: (0 if x.get("syncedLyrics") else 1))
                    for item in arr[:5]:
                        result = pick_result(item)
                        if result:
                            break
                if result:
                    break
            except Exception:
                pass

    if result is None:
        result = {"synced": False, "lines": [], "instrumental": False}

    out = json.dumps(result, ensure_ascii=False)
    cache_file.write_text(out)
    print(out)


if __name__ == "__main__":
    main()
