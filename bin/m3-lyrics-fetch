#!/usr/bin/env python3
"""Fetch synced LRC (or plain) lyrics via LRCLIB with smart cleanup, local cache,
and optional background pre-fetching of the next 2 tracks from Pear Desktop's localhost queue API."""
import hashlib
import json
import pathlib
import re
import subprocess
import sys
import time
import urllib.parse
import urllib.request

CACHE_DIR = pathlib.Path.home() / ".cache/m3-lyrics"
CACHE_DIR.mkdir(parents=True, exist_ok=True)
EMPTY_TTL_SEC = 900  # retry "not found" after 15 min


def clean_str(s: str) -> str:
    s = s or ""
    s = re.sub(
        r"[\(\[\{][^)\]\}]*(official|video|audio|lyric|pv|mv|in-game|sped|slowed|reverb|remaster|hd|4k|hq|live|instrumental)[^)\]\}]*[\)\]\}]",
        "",
        s,
        flags=re.I,
    )
    s = re.sub(r"【[^】]*】", "", s)
    s = re.sub(r"\s+", " ", s).strip(" -–—·|")
    return s


def parse_lrc(lrc_text: str):
    lines = []
    for raw in lrc_text.splitlines():
        matches = list(re.finditer(r"\[(\d+):(\d+(?:\.\d+)?)\]", raw))
        if not matches:
            continue
        text = re.sub(r"\[(\d+):(\d+(?:\.\d+)?)\]", "", raw).strip()
        if not text:
            continue
        for m in matches:
            sec = int(m.group(1)) * 60 + float(m.group(2))
            lines.append({"time": round(sec, 2), "text": text})
    lines.sort(key=lambda x: x["time"])
    return lines


def http_json(url: str, timeout: float = 5.0):
    req = urllib.request.Request(url, headers={"User-Agent": "M3-Expressive-Desktop/1.1"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8", errors="replace"))


def pick_result(item: dict):
    if not item:
        return None
    if item.get("syncedLyrics"):
        parsed = parse_lrc(item["syncedLyrics"])
        if parsed:
            return {"synced": True, "lines": parsed, "instrumental": False}
    if item.get("plainLyrics"):
        plain = [{"time": -1, "text": l.strip()} for l in item["plainLyrics"].splitlines() if l.strip()]
        if plain:
            return {"synced": False, "lines": plain, "instrumental": False}
    if item.get("instrumental"):
        return {"synced": False, "lines": [], "instrumental": True}
    return None


def fetch_and_cache(artist: str, title: str) -> dict:
    orig_artist, orig_title = artist, title
    if " - " in title and (not artist or artist.lower() in ("telegram desktop", "chromium", "firefox", "zen", "pear desktop")):
        parts = title.split(" - ", 1)
        artist = parts[0].strip()
        title = parts[1].strip()

    c_artist = clean_str(artist)
    c_title = clean_str(title)
    if not c_title:
        return {"synced": False, "lines": [], "instrumental": False}

    key_hash = hashlib.sha1(f"{c_artist.lower()}||{c_title.lower()}".encode()).hexdigest()
    cache_file = CACHE_DIR / f"{key_hash}.json"
    if cache_file.exists():
        try:
            cached = json.loads(cache_file.read_text())
            has_content = bool(cached.get("lines")) or bool(cached.get("instrumental"))
            age = time.time() - cache_file.stat().st_mtime
            if has_content or age < EMPTY_TTL_SEC:
                return cached
        except Exception:
            pass

    result = None
    if c_artist:
        try:
            q = urllib.parse.urlencode({"artist_name": c_artist, "track_name": c_title})
            result = pick_result(http_json(f"https://lrclib.net/api/get?{q}"))
        except Exception:
            pass

    if result is None:
        for qstr in [f"{c_artist} {c_title}".strip(), c_title]:
            try:
                q = urllib.parse.urlencode({"q": qstr})
                arr = http_json(f"https://lrclib.net/api/search?{q}")
                if isinstance(arr, list) and arr:
                    arr.sort(key=lambda x: (0 if x.get("syncedLyrics") else 1))
                    for item in arr[:5]:
                        result = pick_result(item)
                        if result:
                            break
                if result:
                    break
            except Exception:
                pass

    if result is None:
        result = {"synced": False, "lines": [], "instrumental": False}

    try:
        cache_file.write_text(json.dumps(result, ensure_ascii=False))
    except Exception:
        pass
    return result


def extract_renderer_track(item: dict):
    """Parse YouTube Music / Pear Desktop queue item (playlistPanelVideoRenderer)."""
    if not isinstance(item, dict):
        return None
    r = item.get("playlistPanelVideoRenderer")
    if not r and "playlistPanelVideoWrapperRenderer" in item:
        w = item["playlistPanelVideoWrapperRenderer"]
        r = (w.get("primaryRenderer") or {}).get("playlistPanelVideoRenderer")
    if not isinstance(r, dict):
        return None
    title_runs = (r.get("title") or {}).get("runs") or []
    title = "".join(x.get("text", "") for x in title_runs).strip()
    by_runs = (r.get("shortBylineText") or r.get("longBylineText") or {}).get("runs") or []
    artist = by_runs[0].get("text", "").strip() if by_runs else ""
    selected = bool(r.get("selected", False))
    if not title:
        return None
    return (artist, title, selected)


def prefetch_pear_queue():
    """Silently pre-fetch lyrics for the next 2 tracks in Pear Desktop's local queue."""
    try:
        data = http_json("http://127.0.0.1:26538/api/v1/queue", timeout=0.6)
    except Exception:
        return
    items = data.get("items") if isinstance(data, dict) else (data if isinstance(data, list) else [])
    parsed = []
    sel_idx = -1
    for it in items:
        tr = extract_renderer_track(it)
        if tr:
            if tr[2]:
                sel_idx = len(parsed)
            parsed.append(tr)
    if sel_idx < 0 or sel_idx + 1 >= len(parsed):
        return
    for nxt_artist, nxt_title, _ in parsed[sel_idx + 1 : sel_idx + 3]:
        try:
            fetch_and_cache(nxt_artist, nxt_title)
        except Exception:
            pass


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--prefetch-queue":
        prefetch_pear_queue()
        return

    artist = sys.argv[1] if len(sys.argv) > 1 else ""
    title = sys.argv[2] if len(sys.argv) > 2 else ""
    req_key = sys.argv[3] if len(sys.argv) > 3 else f"{artist}||{title}"

    res = dict(fetch_and_cache(artist, title))
    res["key"] = req_key
    print(json.dumps(res, ensure_ascii=False), flush=True)

    # Kick off non-blocking background prefetch of next 2 queued songs (Pear Desktop local API)
    try:
        subprocess.Popen(
            [sys.executable, str(pathlib.Path(__file__).resolve()), "--prefetch-queue"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        pass


if __name__ == "__main__":
    main()
