    return base_txt, ov, remap_blue, "#eaf3e7", 0.80, HOME / "Изображения/M3-Expressive-Forest.tdesktop-theme"


def main():
    if not NIGHT_PAL.exists() or not COLORS_JSON.exists():
        return
    c = json.loads(COLORS_JSON.read_text())
    tg_style = c.get("_tg_style") or (
        "forest-light" if c.get("_mode") == "light" else
        ("slate-blue" if c.get("_profile") == "blue" else
         ("peach" if c.get("_profile") == "peach" else "sakura"))
    )

    if tg_style == "forest-light":
        colors_txt, ov, remap_blue, scrim_hex, scrim_alpha, named_out = build_forest_light(c)
    else:
        colors_txt = NIGHT_PAL.read_text()
        if tg_style == "slate-blue":
            seed_accent = mix(c["primary"], "#adc6ff", 0.35)
            seed_deep   = mix(c["primary_container"], c["secondary_container"], 0.45)
            s_rail    = boost_chroma(mix(c["surface_container_lowest"], "#0c0e13", 0.30), 0.95, 0.10, 0.15, 0.0)
            s_list    = boost_chroma(mix(c["surface_container_low"], c["surface"], 0.20), 0.95, 0.10, 0.15, -0.005)
            s_bar     = boost_chroma(mix(c["surface_container"], c["surface_container_high"], 0.18), 0.95, 0.10, 0.16, 0.0)
            s_bubble  = boost_chroma(mix(c["surface_container_high"], c["secondary_container"], 0.16), 0.95, 0.12, 0.18, 0.008)
            s_hover   = boost_chroma(mix(c["surface_container_highest"], c["secondary_container"], 0.24), 0.95, 0.13, 0.20, 0.010)
            s_ripple  = boost_chroma(mix(c["surface_container_highest"], c["primary_container"], 0.26), 0.95, 0.16, 0.24, 0.012)
            mid_tone  = boost_chroma(mix(c["primary_container"], c["secondary_container"], 0.35), 0.85, 0.22, 0.30, -0.010)
            s_out_bg  = ensure_bg_for_white(mid_tone, 7.8)
            s_out_sel = ensure_bg_for_white(boost_chroma(mix(s_out_bg, seed_accent, 0.20), 0.90, 0.24, 0.34, 0.02), 5.8)
            s_act_bg  = ensure_bg_for_white(boost_chroma(mix(c["secondary_container"], c["primary_container"], 0.22), 0.88, 0.18, 0.25, -0.012), 9.0)
            accent_bg       = ensure_bg_for_white(boost_chroma(mix(mid_tone, seed_accent, 0.25), 0.88, 0.24, 0.32, 0.02), 5.5)
            accent_bg_over  = ensure_bg_for_white(boost_chroma(mix(accent_bg, seed_accent, 0.16), 0.90, 0.26, 0.35, 0.02), 4.8)
            muted_badge_bg  = ensure_bg_for_white(boost_chroma(mix(c["surface_container_highest"], c["secondary_container"], 0.35), 0.90, 0.12, 0.18, 0.015), 8.6)
            muted_badge_ovr = ensure_bg_for_white(boost_chroma(mix(muted_badge_bg, seed_accent, 0.18), 0.90, 0.14, 0.20, 0.025), 6.6)
            fg_primary     = "#f5f7fc"
            fg_secondary   = ensure_contrast(mix(c["on_surface_variant"], "#ebf0fa", 0.44), s_bubble, 9.0, True)
            fg_icon        = ensure_contrast(mix(c["on_surface_variant"], "#ebf0fa", 0.48), s_bar, 10.2, True)
            fg_link_in     = ensure_contrast(mix(seed_accent, "#edf3ff", 0.22), s_bubble, 10.0, True)
            fg_link_out    = ensure_contrast(mix(c["primary_fixed"], "#ffffff", 0.28), s_out_bg, 6.8, True)
            fg_out_date    = ensure_contrast(mix(c["on_primary_container"], "#ffffff", 0.35), s_out_bg, 7.0, True)
            fg_out_icon    = "#f2f6ff"
            fg_act_sub     = ensure_contrast(mix(c["on_secondary_container"], "#ffffff", 0.40), s_act_bg, 8.2, True)
            fg_act_date    = ensure_contrast(mix(c["on_secondary_container"], "#ffffff", 0.25), s_act_bg, 7.6, True)
            fg_draft       = ensure_contrast(mix(c["tertiary"], "#f5ecff", 0.22), s_list, 10.0, True)
            fg_on_light    = ensure_contrast(c["on_primary"], seed_accent, 10.5, False)
            sel_badge_act  = mix(seed_accent, "#ffffff", 0.22)
            sel_badge_mut  = mix(c["on_surface_variant"], "#edf2fc", 0.25)
            online_badge   = ensure_contrast(seed_accent, s_list, 7.0, True)
            mono_in_fg     = ensure_contrast(mix(seed_accent, "#d7e6ff", 0.30), s_bubble, 8.5, True)
            divider_hex    = boost_chroma(mix(c["outline_variant"], c["secondary_container"], 0.35), 0.90, 0.12, 0.18, 0.02)
            named_out      = HOME / "Изображения/M3-Expressive-Blue.tdesktop-theme"

        elif tg_style == "peach":
            seed_accent = mix(c["primary"], c["tertiary"], 0.22)
            seed_deep   = mix(c["primary_container"], c["secondary_container"], 0.35)
            s_rail    = boost_chroma(mix(c["surface_container_lowest"], "#120c09", 0.28), 0.92, 0.10, 0.16, -0.005)
            s_list    = boost_chroma(mix(c["surface_container_low"], c["surface"], 0.22), 0.92, 0.11, 0.17, -0.008)
            s_bar     = boost_chroma(mix(c["surface_container"], c["surface_container_high"], 0.22), 0.92, 0.12, 0.18, 0.0)
            s_bubble  = boost_chroma(mix(c["surface_container_high"], c["secondary_container"], 0.18), 0.92, 0.13, 0.19, 0.008)
            s_hover   = boost_chroma(mix(c["surface_container_highest"], c["secondary_container"], 0.25), 0.92, 0.14, 0.21, 0.010)
            s_ripple  = boost_chroma(mix(c["surface_container_highest"], c["primary_container"], 0.28), 0.92, 0.16, 0.24, 0.012)
            mid_tone  = boost_chroma(mix(c["primary_container"], c["secondary_container"], 0.35), 0.82, 0.22, 0.30, -0.012)
            s_out_bg  = ensure_bg_for_white(mid_tone, 7.6)
            s_out_sel = ensure_bg_for_white(boost_chroma(mix(s_out_bg, seed_accent, 0.20), 0.88, 0.24, 0.34, 0.02), 5.7)
            s_act_bg  = ensure_bg_for_white(boost_chroma(mix(mid_tone, s_list, 0.22), 0.84, 0.19, 0.26, -0.012), 8.8)
            accent_bg       = ensure_bg_for_white(boost_chroma(mix(mid_tone, seed_accent, 0.26), 0.88, 0.26, 0.34, 0.02), 5.4)
            accent_bg_over  = ensure_bg_for_white(boost_chroma(mix(accent_bg, seed_accent, 0.16), 0.90, 0.28, 0.36, 0.02), 4.8)
            muted_badge_bg  = ensure_bg_for_white(boost_chroma(mix(c["surface_container_highest"], c["secondary_container"], 0.32), 0.88, 0.12, 0.19, 0.015), 8.5)
            muted_badge_ovr = ensure_bg_for_white(boost_chroma(mix(muted_badge_bg, seed_accent, 0.18), 0.88, 0.14, 0.22, 0.025), 6.6)
            fg_primary     = "#fdf7f3"
            fg_secondary   = ensure_contrast(mix(c["on_surface_variant"], "#fbf0e8", 0.44), s_bubble, 9.0, True)
            fg_icon        = ensure_contrast(mix(c["on_surface_variant"], "#fbf0e8", 0.48), s_bar, 10.2, True)
            fg_link_in     = ensure_contrast(mix(seed_accent, "#fff2e8", 0.24), s_bubble, 9.8, True)
            fg_link_out    = ensure_contrast(mix(c["tertiary"], "#fff6e5", 0.34), s_out_bg, 6.6, True)
            fg_out_date    = ensure_contrast(mix(c["on_primary_container"], "#ffffff", 0.35), s_out_bg, 6.8, True)
            fg_out_icon    = "#fff7f0"
            fg_act_sub     = ensure_contrast(mix(c["on_primary_container"], "#ffffff", 0.42), s_act_bg, 8.2, True)
            fg_act_date    = ensure_contrast(mix(c["on_primary_container"], "#ffffff", 0.28), s_act_bg, 7.6, True)
            fg_draft       = ensure_contrast(mix(c["tertiary"], "#fff4dc", 0.18), s_list, 10.2, True)
            fg_on_light    = ensure_contrast(c["on_primary"], seed_accent, 10.5, False)
            sel_badge_act  = mix(seed_accent, "#ffffff", 0.24)
            sel_badge_mut  = mix(c["on_surface_variant"], "#fbf0e8", 0.25)
            online_badge   = ensure_contrast(c["tertiary"], s_list, 7.0, True)
            mono_in_fg     = ensure_contrast(c["tertiary"], s_bubble, 7.6, True)
            divider_hex    = boost_chroma(mix(c["outline_variant"], c["secondary_container"], 0.34), 0.88, 0.12, 0.18, 0.02)
            named_out      = HOME / "Изображения/M3-Expressive-Peach.tdesktop-theme"

        else:  # sakura
            seed_accent = mix(c["tertiary"], c["primary"], 0.20)
            seed_deep   = mix(c["tertiary_container"], c["primary_container"], 0.25)
            s_rail    = boost_chroma(mix(c["surface_container_lowest"], seed_deep, 0.07), 0.95, 0.08, 0.14, -0.005)
            s_list    = boost_chroma(mix(c["surface_container_low"], seed_deep, 0.10), 0.95, 0.09, 0.15, -0.012)
