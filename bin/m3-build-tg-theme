        def remap_blue(hex_str: str) -> str:
            raw = hex_str.lstrip("#").lower()
            alpha = raw[6:8] if len(raw) == 8 else ""
            r, g, b = int(raw[0:2], 16) / 255.0, int(raw[2:4], 16) / 255.0, int(raw[4:6], 16) / 255.0
            h, l, s = colorsys.rgb_to_hls(r, g, b)
            if 0.48 <= h <= 0.68 and s > 0.04:
                if l < 0.25 and s < 0.42:
                    nh, ns = s_h, min(s * 0.45, max(s_s, 0.10))
                elif s >= 0.42 or l >= 0.45:
                    nh, ns = p_h, min(0.70, max(s * 0.72, p_s * 0.65))
                else:
                    nh, ns = s_h, min(s * 0.50, 0.16)
                nr, ng, nb = colorsys.hls_to_rgb(nh, l, ns)
                return rgb_to_hex(nr * 255, ng * 255, nb * 255, alpha)
            return "#" + raw

        divider_pane = divider_hex + "78"
