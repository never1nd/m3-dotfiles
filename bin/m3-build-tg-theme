#!/usr/bin/env python3
"""Build a complete Material Design 3 Expressive (MD3E) High-Readability
.tdesktop-theme ZIP (colors.tdesktop-theme + calm M3-tinted wallpaper background.jpg).

Supports all 4 profile styles via colors.json `_tg_style`:
- "sakura":       Tender evening sakura blossom (dark, dusty rose-plum)
- "slate-blue":   Calm neutral KeqDroid slate-blue (dark, steel-cornflower)
- "peach":        Warm velvety peach & tangerine (dark, soft apricot-cocoa)
- "forest-light": Sunlit morning forest & sage (light, airy woodland moss)
"""
import colorsys
import json
import pathlib
import re
import shutil
import subprocess
import tempfile
import zipfile

HOME = pathlib.Path.home()
NIGHT_PAL = HOME / ".config/matugen/tdesktop-night-base.txt"
DAY_PAL = HOME / ".config/matugen/tdesktop-day-base.txt"
COLORS_JSON = HOME / ".config/quickshell/colors.json"
OUT_THEME = HOME / "Изображения/M3-Expressive.tdesktop-theme"


def hex_to_rgb(h: str):
    h = h.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def rgb_to_hex(r, g, b, a=""):
    return f"#{max(0, min(255, int(round(r)))):02x}{max(0, min(255, int(round(g)))):02x}{max(0, min(255, int(round(b)))):02x}{a}"


def mix(h1: str, h2: str, t: float, a=""):
    r1, g1, b1 = hex_to_rgb(h1)
    r2, g2, b2 = hex_to_rgb(h2)
    return rgb_to_hex(r1 + (r2 - r1) * t, g1 + (g2 - g1) * t, b1 + (b2 - b1) * t, a)


def rel_luminance(h: str) -> float:
    def lin(v):
        v /= 255.0
        return v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4
    r, g, b = hex_to_rgb(h)
    return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)


def contrast_ratio(h1: str, h2: str) -> float:
    l1, l2 = rel_luminance(h1), rel_luminance(h2)
    hi, lo = max(l1, l2), min(l1, l2)
    return (hi + 0.05) / (lo + 0.05)


def ensure_contrast(fg: str, bg: str, min_ratio: float = 4.6, prefer_light: bool = True) -> str:
    if contrast_ratio(fg, bg) >= min_ratio:
        return fg
    target = "#ffffff" if prefer_light else "#101c13"
    for step in range(1, 41):
        cand = mix(fg, target, step / 40.0)
        if contrast_ratio(cand, bg) >= min_ratio:
            return cand
    return target


def boost_chroma(h: str, sat_mult: float = 1.0, min_sat: float = 0.08, max_sat: float = 0.30, light_delta: float = 0.0) -> str:
    r, g, b = [v / 255.0 for v in hex_to_rgb(h)]
    hue, lum, sat = colorsys.rgb_to_hls(r, g, b)
    ns = min(max_sat, max(min_sat, sat * sat_mult))
    nl = max(0.03, min(0.97, lum + light_delta))
    nr, ng, nb = colorsys.hls_to_rgb(hue, nl, ns)
    return rgb_to_hex(nr * 255, ng * 255, nb * 255)


def ensure_bg_for_white(bg: str, min_ratio: float = 5.2) -> str:
    if contrast_ratio("#ffffff", bg) >= min_ratio:
        return bg
    for step in range(1, 41):
        cand = mix(bg, "#0a100c", step / 40.0)
        if contrast_ratio("#ffffff", cand) >= min_ratio:
            return cand
    return "#2b3b57"


def build_forest_light(c: dict):
    base_txt = DAY_PAL.read_text() if DAY_PAL.exists() else NIGHT_PAL.read_text()

    # Airy sunlit forest light surfaces (M3 Light Tonal Elevation Ladder)
    s_rail    = "#e5efe2"   # L0: cool morning-mist folder rail
    s_list    = "#f4f9f1"   # L1: bright sunlit chat list
    s_bar     = "#ebf3e8"   # L2: soft sage header / compose bar
    s_bubble  = "#ffffff"   # L3: crisp white incoming message bubble
    s_hover   = "#e2ede0"   # L4: gentle sage hover
    s_ripple  = "#d1e5cf"   # L5: active ripple

    s_out_bg  = "#d2ebd3"   # gentle sunlit birch-leaf outgoing bubble
    s_out_sel = "#bce0be"
    s_act_bg  = "#cde6ce"   # soft sage active selected chat

    accent_bg       = ensure_bg_for_white(c.get("primary", "#35693f"), 5.8)
    accent_bg_over  = ensure_bg_for_white(mix(accent_bg, "#1b4424", 0.16), 6.8)
    muted_badge_bg  = ensure_bg_for_white("#5e7262", 5.2)
    muted_badge_ovr = ensure_bg_for_white("#4e6152", 6.2)

    fg_primary   = "#142117"  # deep pine ink (>15:1 on white/list!)
    fg_secondary = "#3e5242"  # calm woodland moss (>7.5:1 AAA on white/list!)
    fg_icon      = "#3c5241"
    fg_link_in   = ensure_contrast(accent_bg, s_bubble, 6.0, False)
    fg_link_out  = ensure_contrast("#23552d", s_out_bg, 6.2, False)
    fg_out_date  = ensure_contrast("#2f5436", s_out_bg, 5.8, False)
    divider_hex  = "#b8cbb9"
    divider_pane = divider_hex + "aa"
    divider_row  = divider_hex + "66"

    seed_accent = accent_bg
    pr, pg, pb = hex_to_rgb(seed_accent)
    p_h, _, p_s = colorsys.rgb_to_hls(pr / 255.0, pg / 255.0, pb / 255.0)

    def remap_blue(hex_str: str) -> str:
        raw = hex_str.lstrip("#").lower()
        alpha = raw[6:8] if len(raw) == 8 else ""
        r, g, b = int(raw[0:2], 16) / 255.0, int(raw[2:4], 16) / 255.0, int(raw[4:6], 16) / 255.0
        h, l, s = colorsys.rgb_to_hls(r, g, b)
        if 0.48 <= h <= 0.68 and s > 0.05:
            nh, ns = p_h, min(0.45, max(s * 0.60, p_s * 0.55))
            nr, ng, nb = colorsys.hls_to_rgb(nh, l, ns)
            return rgb_to_hex(nr * 255, ng * 255, nb * 255, alpha)
        return "#" + raw

    ov = {
        "shadowFg": divider_pane,
        "menuSeparatorFg": divider_hex,
        "dialogsDividerFg": divider_row,
        "inputBorderFg": "#9cb39e",
        "activeLineFg": accent_bg,
        "placeholderFg": fg_secondary,
        "placeholderFgActive": fg_secondary,

        "windowBg": s_list,
        "windowFg": fg_primary,
        "windowBgOver": s_hover,
        "windowBgRipple": s_ripple,
        "windowFgOver": fg_primary,
        "windowSubTextFg": fg_secondary,
        "windowSubTextFgOver": fg_primary,
        "windowBoldFg": fg_primary,
        "windowBoldFgOver": fg_primary,
        "windowBgActive": accent_bg,
        "windowFgActive": "#ffffff",
        "windowActiveTextFg": fg_link_in,

        "titleBg": s_rail,
        "titleBgActive": s_rail,
        "titleShadow": divider_pane,
        "titleFg": fg_secondary,
        "titleFgActive": fg_primary,
        "topBarBg": s_bar,

        "sideBarBg": s_rail,
        "sideBarBgActive": s_act_bg,
        "sideBarBgRipple": s_ripple,
        "sideBarTextFg": fg_secondary,
        "sideBarTextFgActive": fg_primary,
        "sideBarIconFg": fg_icon,
        "sideBarIconFgActive": accent_bg,
        "sideBarBadgeBg": accent_bg,
        "sideBarBadgeBgMuted": muted_badge_bg,
        "sideBarBadgeFg": "#ffffff",

        "dialogsBg": s_list,
        "dialogsBgOver": s_hover,
        "dialogsBgRipple": s_ripple,
        "dialogsBgActive": s_act_bg,
        "dialogsMenuIconFg": fg_icon,
        "dialogsMenuIconFgOver": accent_bg,
        "dialogsNameFg": fg_primary,
        "dialogsNameFgOver": fg_primary,
        "dialogsNameFgActive": fg_primary,
        "dialogsChatIconFg": accent_bg,
        "dialogsChatIconFgOver": accent_bg,
        "dialogsChatIconFgActive": fg_primary,
        "dialogsDateFg": fg_secondary,
        "dialogsDateFgOver": fg_primary,
        "dialogsDateFgActive": fg_out_date,
        "dialogsTextFg": fg_secondary,
        "dialogsTextFgOver": fg_primary,
        "dialogsTextFgActive": fg_primary,
        "dialogsTextFgService": fg_link_in,
        "dialogsTextFgServiceOver": fg_link_in,
        "dialogsTextFgServiceActive": fg_link_out,
        "dialogsDraftFg": "#a8442a",
        "dialogsDraftFgOver": "#a8442a",
        "dialogsDraftFgActive": "#8f321b",
        "dialogsVerifiedIconBg": accent_bg,
        "dialogsVerifiedIconFg": "#ffffff",
        "dialogsVerifiedIconBgActive": accent_bg,
        "dialogsVerifiedIconFgActive": "#ffffff",
        "dialogsSendingIconFg": fg_secondary,
        "dialogsSentIconFg": accent_bg,
        "dialogsSentIconFgOver": accent_bg,
        "dialogsSentIconFgActive": fg_link_out,
        "dialogsUnreadBg": accent_bg,
        "dialogsUnreadBgOver": accent_bg_over,
        "dialogsUnreadBgMuted": muted_badge_bg,
        "dialogsUnreadBgMutedOver": muted_badge_ovr,
        "dialogsUnreadFg": "#ffffff",
        "dialogsUnreadFgOver": "#ffffff",
        "dialogsUnreadBgActive": accent_bg,
        "dialogsUnreadBgMutedActive": muted_badge_bg,
        "dialogsUnreadFgActive": "#ffffff",
        "dialogsOnlineBadgeFg": "#2f7d42",
        "dialogsOnlineBadgeFgActive": "#215c30",
        "dialogsPinnedIconFg": accent_bg,
        "dialogsPinnedIconFgOver": accent_bg,
        "dialogsPinnedIconFgActive": fg_link_out,

        "filterInputInactiveBg": "#e3eee0",
        "filterInputActiveBg": "#ffffff",
        "filterInputBorderFg": accent_bg,
        "searchedBarBg": s_bar,
        "searchedBarFg": fg_primary,

        "boxBg": "#ffffff",
        "boxTextFg": fg_primary,
        "boxTitleFg": fg_primary,
        "boxTitleAdditionalFg": fg_secondary,
        "boxTitleCloseFg": fg_icon,
        "boxTitleCloseFgOver": accent_bg,
        "boxSearchBg": "#eef5eb",
        "menuBg": "#ffffff",
        "menuBgOver": s_hover,
        "menuBgRipple": s_ripple,
        "menuIconFg": fg_icon,
