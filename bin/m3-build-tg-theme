        "msgOutBgSelected": s_out_sel,
        "msgInShadow": "#00000000",
        "msgInShadowSelected": "#00000000",
        "msgOutShadow": "#00000000",
        "msgOutShadowSelected": "#00000000",
        "historyTextInFg": fg_primary,
        "historyTextInFgSelected": fg_primary,
        "historyTextOutFg": fg_primary,
        "historyTextOutFgSelected": fg_primary,
        "historyLinkInFg": fg_link_in,
        "historyLinkOutFg": fg_link_out,
        "msgInDateFg": fg_secondary,
        "msgOutDateFg": fg_out_date,
        "historyOutIconFg": accent_bg,
        "historyOutIconFgSelected": fg_link_out,
        "msgInServiceFg": fg_link_in,
        "msgOutServiceFg": fg_link_out,
        "msgInReplyBarColor": accent_bg,
        "msgOutReplyBarColor": fg_link_out,
        "msgInMonoFg": "#255732",
        "msgOutMonoFg": "#1b4526",
        "msgFileInBg": accent_bg,
        "msgFileInBgOver": accent_bg_over,
        "msgFileOutBg": accent_bg,
        "msgFileOutBgOver": accent_bg_over,
        "msgWaveformInActive": accent_bg,
        "msgWaveformInInactive": "#b5c9b7",
        "msgWaveformOutActive": fg_link_out,
        "msgWaveformOutInactive": "#97b89b",

        "msgServiceBg": "#e4efe1e6",
        "msgServiceBgSelected": "#cde3cbe6",
        "msgServiceFg": fg_primary,
