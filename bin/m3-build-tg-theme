            "historyPeer1NameFg": peers[0], "historyPeer2NameFg": peers[1], "historyPeer3NameFg": peers[2],
            "historyPeer4NameFg": peers[3], "historyPeer5NameFg": peers[4], "historyPeer6NameFg": peers[5],
            "historyPeer7NameFg": peers[6], "historyPeer8NameFg": peers[7],
        }
        scrim_hex, scrim_alpha = s_rail, 0.88

    out_lines = [f"// Material Design 3 Expressive {tg_style} Theme ({c.get('_scheme', '')}, {c.get('_mode', '')})"]
    seen = set()
    token_re = re.compile(r"^(\s*)([a-zA-Z0-9_]+)(\s*:\s*)(#[0-9a-fA-F]{6,8}|[a-zA-Z0-9_]+)(\s*;.*)$")
    for line in colors_txt.splitlines():
        m = token_re.match(line)
        if m:
            indent, key, sep, old_val, tail = m.groups()
            seen.add(key)
            if key in ov:
                new_val = ov[key]
            elif old_val.startswith("#"):
                new_val = remap_blue(old_val)
            else:
                new_val = old_val
            out_lines.append(f"{indent}{key}{sep}{new_val}{tail}")
        else:
            out_lines.append(line)

    for k, v in ov.items():
        if k not in seen:
            out_lines.append(f"{k}: {v};")

    wp = pathlib.Path(c.get("_wallpaper") or str(HOME / "Изображения/Wallpapers/535592.jpg"))
    sc_r, sc_g, sc_b = hex_to_rgb(scrim_hex)
    OUT_THEME.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(suffix=".jpg", delete=False) as tf:
        bg_path = pathlib.Path(tf.name)
    try:
        has_bg = False
        if wp.exists():
            r = subprocess.run(
                [
                    "ffmpeg", "-y", "-i", str(wp),
                    "-vf", f"scale=1920:1080:force_original_aspect_ratio=increase,crop=1920:1080,gblur=sigma=24,drawbox=x=0:y=0:w=iw:h=ih:color=0x{sc_r:02x}{sc_g:02x}{sc_b:02x}@{scrim_alpha:.2f}:t=fill",
                    "-q:v", "3", str(bg_path),
                ],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            has_bg = (r.returncode == 0 and bg_path.exists() and bg_path.stat().st_size > 1000)
        with zipfile.ZipFile(OUT_THEME, "w", compression=zipfile.ZIP_DEFLATED) as zf:
            zf.writestr("colors.tdesktop-theme", ("\n".join(out_lines) + "\n").encode("utf-8"))
            if has_bg:
                zf.write(bg_path, "background.jpg")
        shutil.copy2(OUT_THEME, named_out)
    finally:
        bg_path.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
