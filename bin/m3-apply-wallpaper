#!/usr/bin/env python3
"""Material Design 3 Expressive Unified Dynamic Theme Engine.
Single source of truth powered by matugen (HCT color space, scheme-expressive)
and awww (Wayland animated wallpaper daemon).

Synchronizes all 50 M3 color roles across:
  Waybar, SwayNC, SwayOSD, Rofi, Niri, Hyprlock, GTK3, GTK4/Libadwaita,
  Qt5ct/Qt6ct (palette + QSS), Kitty, Alacritty, btop, Zen Browser, Telegram.
"""
import argparse
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import time

HOME = pathlib.Path.home()
CFG = HOME / ".config"
STATE_DIR = HOME / ".local/state"
STATE_WP = STATE_DIR / "m3-current-wallpaper"
STATE_MODE = STATE_DIR / "m3-mode"
STATE_SCHEME = STATE_DIR / "m3-scheme"
DEFAULT_WP = HOME / "Изображения/Wallpapers/535592.jpg"
PROFILE_DIR = CFG / "m3-profiles"
PROFILE_ACTIVE = PROFILE_DIR / "active"


def hex_to_rgba_css(h: str, alpha: float) -> str:
    h = h.lstrip("#")
    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    return f"rgba({r}, {g}, {b}, {alpha:.2f})"


def hex_to_hypr_rgba(h: str, alpha_hex: str = "ff") -> str:
    return f"rgba({h.lstrip('#')}{alpha_hex})"


def hex_to_qt_argb(h: str) -> str:
    return f"#ff{h.lstrip('#')}"


def extract_palette(wp: str, mode: str, scheme: str, color_source: str = "wallpaper") -> dict[str, str]:
    if color_source and color_source.startswith("#"):
        cmd = ["matugen", "color", "hex", color_source, "-t", scheme, "-m", mode, "-j", "hex", "--dry-run"]
    else:
        cmd = ["matugen", "image", wp, "--source-color-index", "0", "-t", scheme, "-m", mode, "-j", "hex", "--dry-run"]
    raw = subprocess.check_output(cmd, text=True)
    data = json.loads(raw[raw.find("{") :])
    colors = data.get("colors", {})
    out: dict[str, str] = {}
    for role, val in colors.items():
        if isinstance(val, dict):
            mode_obj = val.get(mode) or val.get("default") or next(iter(val.values()))
            if isinstance(mode_obj, dict) and "color" in mode_obj:
                out[role] = mode_obj["color"]
            elif isinstance(mode_obj, str):
                out[role] = mode_obj
        elif isinstance(val, str):
            out[role] = val
    return out


def ensure_awww_and_set(wp: str) -> None:
    if shutil.which("awww") is None:
        return
    if subprocess.run(["pgrep", "-x", "awww-daemon"], stdout=subprocess.DEVNULL).returncode != 0:
        subprocess.Popen(
            ["awww-daemon"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        for _ in range(25):
            if subprocess.run(["awww", "query"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
                break
            time.sleep(0.08)
    subprocess.run(
        [
            "awww",
            "img",
            wp,
            "--transition-type",
            "grow",
            "--transition-pos",
            "0.5,0.5",
            "--transition-fps",
            "144",
            "--transition-duration",
            "0.85",
            "--transition-bezier",
            ".2,0,0,1",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def write_gtk_css_vars(c: dict[str, str]) -> str:
    lines = ["/* Auto-generated Material Design 3 Expressive color roles */"]
    for k in sorted(c.keys()):
        lines.append(f"@define-color m3_{k} {c[k]};")
    return "\n".join(lines) + "\n"


def write_all_configs(wp: str, mode: str, scheme: str, c: dict[str, str], meta: dict | None = None) -> None:
    meta = meta or {}
    # 0) Quickshell M3 Expressive live JSON tokens
    qs_dir = CFG / "quickshell"
    qs_dir.mkdir(parents=True, exist_ok=True)
    qs_payload = dict(c)
    qs_payload["_mode"] = mode
    qs_payload["_scheme"] = scheme
    qs_payload["_wallpaper"] = wp
    qs_payload["_wallpaper_name"] = pathlib.Path(wp).stem
    qs_payload["_profile"] = meta.get("id", "violet")
    qs_payload["_profile_name"] = meta.get("name", "Лаванда · Сакура")
    qs_payload["_color_source"] = meta.get("color_source", "wallpaper")
    qs_payload["_icon_base"] = meta.get("icon_base", "Tela-circle-purple")
    qs_payload["_tg_style"] = meta.get("tg_style", "sakura")
    (qs_dir / "colors.json").write_text(json.dumps(qs_payload, indent=2, ensure_ascii=False) + "\n")

    # 1) Waybar, SwayNC, SwayOSD colors.css
    gtk_vars = write_gtk_css_vars(c)
    for rel in ["waybar/colors.css", "swaync/colors.css", "swayosd/colors.css"]:
        p = CFG / rel
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(gtk_vars)

    # 2) Rofi m3-colors.rasi
    rofi_lines = ["/* Auto-generated Material Design 3 Expressive tokens */", "* {"]
    for k in sorted(c.keys()):
        kebab = k.replace("_", "-")
        if k == "surface_container":
            rofi_lines.append(f"    m3-{kebab}: {hex_to_rgba_css(c[k], 0.96)};")
        else:
            rofi_lines.append(f"    m3-{kebab}: {c[k]};")
    rofi_lines.append("}")
    (CFG / "rofi/m3-colors.rasi").write_text("\n".join(rofi_lines) + "\n")

    # 3) Niri m3-colors.kdl (layout accents, overview backdrop, recent-windows)
    (CFG / "niri/m3-colors.kdl").write_text(f"""// Auto-generated Material Design 3 Expressive tokens ({scheme}, {mode})
layout {{
    focus-ring {{
        active-color   "{c['primary']}"
        inactive-color "{c['surface_container_highest']}"
        urgent-color   "{c['error']}"
    }}

    border {{
        active-color   "{c['primary']}"
        inactive-color "{c['surface_container_highest']}"
        urgent-color   "{c['error']}"
    }}

    tab-indicator {{
        active-color   "{c['primary']}"
        inactive-color "{c['secondary_container']}"
        urgent-color   "{c['error']}"
    }}

    insert-hint {{
        color "{c['primary']}66"
    }}
}}

overview {{
    zoom 0.54
    backdrop-color "{c['surface_container_lowest']}"
    workspace-shadow {{
        softness 48
        spread 6
        offset x=0 y=12
        color "#00000080"
    }}
}}

recent-windows {{
    highlight {{
        active-color "{c['primary']}ff"
        urgent-color "{c['error']}ff"
    }}
}}
""")

    # 4) Hyprlock m3-colors.conf
    (CFG / "hypr/m3-colors.conf").write_text(f"""# Auto-generated Material Design 3 Expressive tokens ({scheme}, {mode})
$wallpaper = {wp}
$surface = {hex_to_hypr_rgba(c['surface'], 'ff')}
$surface_container = {hex_to_hypr_rgba(c['surface_container'], 'eb')}
$surface_container_high = {hex_to_hypr_rgba(c['surface_container_high'], 'f2')}
$on_surface = {hex_to_hypr_rgba(c['on_surface'], 'ff')}
$on_surface_variant = {hex_to_hypr_rgba(c['on_surface_variant'], 'ff')}
$primary = {hex_to_hypr_rgba(c['primary'], 'ff')}
$on_primary = {hex_to_hypr_rgba(c['on_primary'], 'ff')}
$tertiary = {hex_to_hypr_rgba(c['tertiary'], 'ff')}
$error = {hex_to_hypr_rgba(c['error'], 'ff')}
$outline_variant = {hex_to_hypr_rgba(c['outline_variant'], 'cc')}
""")

    # 5) GTK3 & GTK4 + Libadwaita @define-color mappings
    adw_map = f"""
/* Libadwaita / GTK4 semantic M3 Expressive bindings */
@define-color accent_color {c['primary']};
@define-color accent_bg_color {c['primary']};
@define-color accent_fg_color {c['on_primary']};
@define-color destructive_color {c['error']};
@define-color destructive_bg_color {c['error_container']};
@define-color destructive_fg_color {c['on_error_container']};
@define-color error_color {c['error']};
@define-color error_bg_color {c['error_container']};
@define-color error_fg_color {c['on_error_container']};
@define-color window_bg_color {c['surface']};
@define-color window_fg_color {c['on_surface']};
@define-color view_bg_color {c['surface_container_low']};
@define-color view_fg_color {c['on_surface']};
@define-color headerbar_bg_color {c['surface_container_low']};
@define-color headerbar_fg_color {c['on_surface']};
@define-color headerbar_border_color {c['outline_variant']};
@define-color headerbar_backdrop_color {c['surface_dim']};
@define-color card_bg_color {c['surface_container']};
@define-color card_fg_color {c['on_surface']};
@define-color dialog_bg_color {c['surface_container_high']};
@define-color dialog_fg_color {c['on_surface']};
@define-color popover_bg_color {c['surface_container_high']};
@define-color popover_fg_color {c['on_surface']};
@define-color sidebar_bg_color {c['surface_container_low']};
@define-color sidebar_fg_color {c['on_surface']};
@define-color secondary_sidebar_bg_color {c['surface']};
@define-color secondary_sidebar_fg_color {c['on_surface_variant']};
"""
    prefer_dark = "1" if mode == "dark" else "0"
    gtk_theme = "adw-gtk3-dark" if mode == "dark" else "adw-gtk3"
    icon_base = meta.get("icon_base") or "Tela-circle-purple"
    icon_theme = f"{icon_base}-dark" if mode == "dark" else f"{icon_base}-light"
    settings_ini = f"""[Settings]
gtk-application-prefer-dark-theme={prefer_dark}
gtk-decoration-layout=
gtk-icon-theme-name={icon_theme}
gtk-theme-name={gtk_theme}
gtk-font-name=Roboto Flex 10
gtk-cursor-theme-name=Bibata-Modern-Ice
gtk-cursor-theme-size=24
"""
    for gv in ("gtk-3.0", "gtk-4.0"):
        gd = CFG / gv
        gd.mkdir(parents=True, exist_ok=True)
        (gd / "m3-tokens.css").write_text(gtk_vars + adw_map)
        (gd / "settings.ini").write_text(settings_ini)

    # Sync GNOME/Portal dconf settings
    if shutil.which("gsettings"):
        color_scheme = "prefer-dark" if mode == "dark" else "prefer-light"
        for k, v in [
            ("color-scheme", color_scheme),
            ("gtk-theme", gtk_theme),
            ("icon-theme", icon_theme),
            ("font-name", "Roboto Flex 10"),
            ("monospace-font-name", "JetBrainsMono Nerd Font 10"),
        ]:
            subprocess.run(
                ["gsettings", "set", "org.gnome.desktop.interface", k, v],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )

    # 6) Qt5ct & Qt6ct dynamic color palette + dynamic M3 Expressive QSS
    active = ", ".join(
        hex_to_qt_argb(x)
        for x in [
            c["on_surface"],                  # WindowText
            c["surface_container_high"],      # Button
            c["surface_container_highest"],   # Light
            c["surface_container"],           # Midlight
            c["surface_container_lowest"],    # Dark
            c["outline_variant"],             # Mid
            c["on_surface"],                  # Text
            c["on_surface"],                  # BrightText
            c["on_surface"],                  # ButtonText
            c["surface_container_low"],       # Base
            c["surface"],                     # Window
            c["shadow"],                      # Shadow
            c["primary_container"],           # Highlight
            c["on_primary_container"],        # HighlightedText
            c["primary"],                     # Link
            c["tertiary"],                    # LinkVisited
            c["surface_container"],           # AlternateBase
            c["surface"],                     # NoRole
            c["inverse_surface"],             # ToolTipBase
            c["inverse_on_surface"],          # ToolTipText
            c["on_surface_variant"],          # PlaceholderText
        ]
    )
    disabled = active.replace(hex_to_qt_argb(c["on_surface"]), hex_to_qt_argb(c["outline"]), 3)
    qt_palette = f"[ColorScheme]\nactive_colors={active}\ndisabled_colors={disabled}\ninactive_colors={active}\n"

    qt_qss = f"""/* Auto-generated Material Design 3 Expressive Qt Stylesheet ({scheme}, {mode}) */
QWidget {{
    background-color: {c['surface']};
    color: {c['on_surface']};
    selection-background-color: {c['primary_container']};
    selection-color: {c['on_primary_container']};
}}
QMainWindow, QDialog {{
    background-color: {c['surface']};
}}
QMenu, QComboBox QAbstractItemView {{
    background-color: {c['surface_container_high']};
    color: {c['on_surface']};
    border: 1px solid {c['outline_variant']};
    border-radius: 20px;
    padding: 8px;
}}
QMenu::item {{
    padding: 8px 18px;
    border-radius: 14px;
    margin: 2px 4px;
}}
QMenu::item:selected {{
    background-color: {c['primary_container']};
    color: {c['on_primary_container']};
}}
QPushButton, QToolButton {{
    background-color: {c['surface_container_high']};
    color: {c['on_surface']};
    border: 1px solid {c['outline_variant']};
    border-radius: 18px;
    padding: 7px 18px;
    font-weight: 600;
}}
QPushButton:hover, QToolButton:hover {{
    background-color: {c['secondary_container']};
    color: {c['on_secondary_container']};
    border-color: {c['secondary']};
}}
QPushButton:pressed, QPushButton:checked, QToolButton:checked {{
    background-color: {c['primary_container']};
    color: {c['on_primary_container']};
    border-radius: 12px;
    border-color: {c['primary']};
}}
QPushButton:default {{
    background-color: {c['primary']};
    color: {c['on_primary']};
    border: none;
}}
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {{
    background-color: {c['surface_container_highest']};
    color: {c['on_surface']};
    border: 1px solid {c['outline_variant']};
    border-radius: 16px;
    padding: 3px 10px;
}}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus {{
    border: 2px solid {c['primary']};
}}
QTabWidget::pane {{
    border: 1px solid {c['outline_variant']};
    border-radius: 20px;
    background-color: {c['surface_container_low']};
    padding: 6px;
}}
QTabBar::tab {{
    background-color: transparent;
    color: {c['on_surface_variant']};
    border-radius: 16px;
    padding: 8px 16px;
    margin: 2px 4px;
    font-weight: 600;
}}
QTabBar::tab:selected {{
    background-color: {c['secondary_container']};
    color: {c['on_secondary_container']};
}}
QListView, QTreeView, QTableView {{
    background-color: {c['surface_container_low']};
    border: 1px solid {c['outline_variant']};
    border-radius: 20px;
    padding: 6px;
    outline: none;
}}
QListView::item, QTreeView::item {{
    border-radius: 14px;
    padding: 6px 10px;
}}
QListView::item:selected, QTreeView::item:selected {{
    background-color: {c['secondary_container']};
    color: {c['on_secondary_container']};
}}
QScrollBar:vertical {{
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}}
QScrollBar::handle:vertical {{
    background: {c['outline']};
    border-radius: 5px;
    min-height: 28px;
}}
QScrollBar::handle:vertical:hover {{
    background: {c['primary']};
}}
QScrollBar::add-line, QScrollBar::sub-line {{
    height: 0px;
    width: 0px;
}}
QToolTip {{
    background-color: {c['inverse_surface']};
    color: {c['inverse_on_surface']};
    border: none;
    border-radius: 12px;
    padding: 6px 10px;
}}
"""
    for qt in ("qt5ct", "qt6ct"):
        (CFG / qt / "colors").mkdir(parents=True, exist_ok=True)
        (CFG / qt / "qss").mkdir(parents=True, exist_ok=True)
        (CFG / qt / "colors/m3-expressive.conf").write_text(qt_palette)
        (CFG / qt / "qss/m3-expressive.qss").write_text(qt_qss)
        conf_p = CFG / qt / f"{qt}.conf"
        if conf_p.exists():
            txt = conf_p.read_text()
            txt = re.sub(r"^icon_theme=.*$", f"icon_theme={icon_theme}", txt, flags=re.MULTILINE)
            txt = txt.replace('general="Roboto,', 'general="Roboto Flex,')
            conf_p.write_text(txt)

    # 7) Kitty terminal M3 Expressive theme
    # Regular interactive terminal keeps a calm deep M3-tinted dark surface even in light mode
    # so truecolor dark TUI apps (prime-agent, nvim, lazygit, etc.) NEVER turn white-on-white,
    # while kitty-desktop uses m3-desktop-override.conf to match the light frosted desktop card!
    if mode == "light":
        term_bg = c["inverse_surface"] if False else "#151d17" if c.get("primary", "").startswith("#3") or c.get("primary", "").startswith("#4") else "#16181c"
        # Derive a calm deep dark surface tinted with the active light theme's hue
        _pr, _pg, _pb = int(c["primary"][1:3], 16), int(c["primary"][3:5], 16), int(c["primary"][5:7], 16)
        term_bg = f"#{int(16 + _pr * 0.08):02x}{int(18 + _pg * 0.10):02x}{int(16 + _pb * 0.08):02x}"
        term_fg = "#edf3ec"
        term_sel_bg = c["primary"]
        term_sel_fg = "#ffffff"
        term_cursor = c["primary_container"]
        term_cursor_fg = c["on_primary_container"]
        term_tab_bg = f"#{int(22 + _pr * 0.09):02x}{int(25 + _pg * 0.11):02x}{int(22 + _pb * 0.09):02x}"
        ansi_dark = {
            "c0": term_tab_bg,
            "c1": "#ffb4ab",
            "c2": c["primary_container"],
            "c3": c["tertiary_container"],
            "c4": c["secondary_container"],
            "c5": c["tertiary_fixed_dim"],
            "c6": c["primary_fixed_dim"],
            "c7": "#cfd8ce",
            "c8": "#7f8c80",
            "c9": "#ffb4ab",
            "c10": c["primary_fixed"],
            "c11": c["tertiary_fixed"],
            "c12": c["secondary_fixed"],
            "c13": c["tertiary_container"],
            "c14": c["primary_container"],
            "c15": "#f4faf3",
        }
        desk_override = f"""# Light-mode override ONLY for transparent desktop fastfetch widget (kitty-desktop)
foreground              {c['on_surface']}
cursor                  {c['primary']}
color0  {c['on_surface']}
color1  {c['error']}
color2  {c['primary']}
color3  {c['tertiary']}
color4  {c['secondary']}
color5  {c['on_tertiary_fixed_variant']}
color6  {c['on_primary_fixed_variant']}
color7  {c['on_surface_variant']}
color8  {c['outline']}
color9  {c['error']}
color10 {c['primary']}
color11 {c['tertiary']}
color12 {c['secondary']}
color13 {c['on_tertiary_fixed_variant']}
color14 {c['on_primary_fixed_variant']}
color15 {c['on_surface']}
"""
    else:
        term_bg = c["surface_container_lowest"]
        term_fg = c["on_surface"]
        term_sel_bg = c["primary_container"]
        term_sel_fg = c["on_primary_container"]
        term_cursor = c["primary"]
        term_cursor_fg = c["on_primary"]
        term_tab_bg = c["surface_container_low"]
        ansi_dark = {
            "c0": c["surface_container"],
            "c1": c["error"],
            "c2": c["primary"],
            "c3": c["tertiary"],
            "c4": c["secondary"],
            "c5": c["tertiary_fixed_dim"],
            "c6": c["primary_fixed_dim"],
            "c7": c["on_surface_variant"],
            "c8": c["outline"],
            "c9": c["error"],
            "c10": c["primary_fixed"],
            "c11": c["tertiary_fixed"],
            "c12": c["secondary_fixed"],
            "c13": c["tertiary"],
            "c14": c["primary"],
            "c15": c["on_surface"],
        }
        desk_override = "# Dark mode: inherit m3-expressive.conf directly\n"
    (CFG / "kitty/themes").mkdir(parents=True, exist_ok=True)
    (CFG / "kitty/themes/m3-desktop-override.conf").write_text(desk_override)
    (CFG / "kitty/themes/m3-expressive.conf").write_text(f"""# Material Design 3 Expressive Kitty Theme ({scheme}, {mode})
background              {term_bg}
foreground              {term_fg}
selection_background    {term_sel_bg}
selection_foreground    {term_sel_fg}
cursor                  {term_cursor}
cursor_text_color       {term_cursor_fg}
url_color               {c['tertiary']}

active_border_color     {c['primary']}
inactive_border_color   {c['outline_variant']}

tab_bar_background      {term_tab_bg}
active_tab_foreground   {c['on_primary_container']}
active_tab_background   {c['primary_container']}
active_tab_font_style   bold
inactive_tab_foreground {c['on_surface_variant']}
inactive_tab_background {c['surface_container_high']}

color0  {ansi_dark['c0']}
color1  {ansi_dark['c1']}
color2  {ansi_dark['c2']}
color3  {ansi_dark['c3']}
color4  {ansi_dark['c4']}
color5  {ansi_dark['c5']}
color6  {ansi_dark['c6']}
color7  {ansi_dark['c7']}
color8  {ansi_dark['c8']}
color9  {ansi_dark['c9']}
color10 {ansi_dark['c10']}
color11 {ansi_dark['c11']}
color12 {ansi_dark['c12']}
color13 {ansi_dark['c13']}
color14 {ansi_dark['c14']}
color15 {ansi_dark['c15']}
""")

    # 8) Alacritty terminal M3 Expressive theme
    (CFG / "alacritty/themes").mkdir(parents=True, exist_ok=True)
    (CFG / "alacritty/themes/m3-expressive.toml").write_text(f"""# Material Design 3 Expressive Alacritty Theme ({scheme}, {mode})
[colors.primary]
background = "{term_bg}"
foreground = "{term_fg}"

[colors.cursor]
text = "{c['on_primary']}"
cursor = "{c['primary']}"

[colors.selection]
text = "{c['on_primary_container']}"
background = "{c['primary_container']}"

[colors.normal]
black   = "{ansi_dark['c0']}"
red     = "{ansi_dark['c1']}"
green   = "{ansi_dark['c2']}"
yellow  = "{ansi_dark['c3']}"
blue    = "{ansi_dark['c4']}"
magenta = "{ansi_dark['c5']}"
cyan    = "{ansi_dark['c6']}"
white   = "{ansi_dark['c7']}"

[colors.bright]
black   = "{ansi_dark['c8']}"
red     = "{ansi_dark['c9']}"
green   = "{ansi_dark['c10']}"
yellow  = "{ansi_dark['c11']}"
blue    = "{ansi_dark['c12']}"
magenta = "{ansi_dark['c13']}"
cyan    = "{ansi_dark['c14']}"
white   = "{ansi_dark['c15']}"
""")

    # 9) btop dynamic M3 Expressive theme
    (CFG / "btop/themes").mkdir(parents=True, exist_ok=True)
    (CFG / "btop/themes/m3-expressive.theme").write_text(f"""# Material Design 3 Expressive btop Theme ({scheme}, {mode})
theme[main_bg]="{c['surface']}"
theme[main_fg]="{c['on_surface']}"
theme[title]="{c['on_surface']}"
theme[hi_fg]="{c['primary']}"
theme[selected_bg]="{c['primary_container']}"
theme[selected_fg]="{c['on_primary_container']}"
theme[inactive_fg]="{c['outline']}"
theme[graph_text]="{c['on_surface_variant']}"
theme[meter_bg]="{c['surface_container_highest']}"
theme[proc_misc]="{c['tertiary']}"
theme[cpu_box]="{c['primary']}"
theme[mem_box]="{c['secondary']}"
theme[net_box]="{c['tertiary']}"
theme[proc_box]="{c['outline_variant']}"
theme[div_line]="{c['outline_variant']}"
theme[temp_start]="{c['primary']}"
theme[temp_mid]="{c['tertiary']}"
theme[temp_end]="{c['error']}"
theme[cpu_start]="{c['primary']}"
theme[cpu_mid]="{c['secondary']}"
theme[cpu_end]="{c['tertiary']}"
theme[free_start]="{c['primary']}"
theme[free_mid]="{c['primary_fixed_dim']}"
theme[free_end]="{c['secondary']}"
theme[cached_start]="{c['secondary']}"
theme[cached_mid]="{c['tertiary']}"
theme[cached_end]="{c['tertiary']}"
theme[available_start]="{c['primary']}"
theme[available_mid]="{c['secondary']}"
theme[available_end]="{c['tertiary']}"
theme[used_start]="{c['tertiary']}"
theme[used_mid]="{c['secondary']}"
theme[used_end]="{c['error']}"
theme[download_start]="{c['primary']}"
theme[download_mid]="{c['secondary']}"
theme[download_end]="{c['tertiary']}"
theme[upload_start]="{c['tertiary']}"
theme[upload_mid]="{c['secondary']}"
theme[upload_end]="{c['error']}"
""")

    # 10) Zen Browser chrome/m3-colors.css
    zen_root = CFG / "zen"
    if zen_root.exists():
        for prof in zen_root.glob("*/chrome"):
            (prof / "m3-colors.css").write_text(f"""/* Auto-generated Material Design 3 Expressive colors for Zen Browser ({scheme}, {mode}) */
:root {{
    --m3-surface: {c['surface']};
    --m3-surface-container-low: {c['surface_container_low']};
    --m3-surface-container: {c['surface_container']};
    --m3-surface-container-high: {c['surface_container_high']};
    --m3-surface-container-highest: {c['surface_container_highest']};
    --m3-primary: {c['primary']};
    --m3-on-primary: {c['on_primary']};
    --m3-primary-container: {c['primary_container']};
    --m3-on-primary-container: {c['on_primary_container']};
    --m3-secondary-container: {c['secondary_container']};
    --m3-on-secondary-container: {c['on_secondary_container']};
    --m3-tertiary-container: {c['tertiary_container']};
    --m3-on-surface: {c['on_surface']};
    --m3-on-surface-variant: {c['on_surface_variant']};
    --m3-outline-variant: {c['outline_variant']};
}}
""")

    # 11) Full 510-token Material Design 3 Expressive Telegram / AyuGram ZIP theme
    subprocess.run(["__HOME__/.local/bin/m3-build-tg-theme"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 14) Live Material Design 3 Expressive GtkSourceView-5 scheme (gnome-text-editor) + Celluloid dark/light sync
    sv_dir = HOME / ".local/share/gtksourceview-5/styles"
    sv_dir.mkdir(parents=True, exist_ok=True)
    sv_kind = "dark" if mode == "dark" else "light"
    (sv_dir / "m3-expressive.xml").write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="m3-expressive" _name="Material Design 3 Expressive" version="1.0">
  <author>Material 3 Expressive</author>
  <description>Dynamic M3 Expressive palette synced with active profile ({scheme}, {mode})</description>
  <metadata>
    <property name="variant">{sv_kind}</property>
  </metadata>

  <color name="bg"          value="{c['surface_container_low']}"/>
  <color name="bg_cur"      value="{c['surface_container']}"/>
  <color name="bg_sel"      value="{c['primary_container']}"/>
  <color name="fg"          value="{c['on_surface']}"/>
  <color name="fg_dim"      value="{c['on_surface_variant']}"/>
  <color name="fg_sel"      value="{c['on_primary_container']}"/>
  <color name="outline"     value="{c['outline_variant']}"/>
  <color name="primary"     value="{c['primary']}"/>
  <color name="secondary"   value="{c['secondary']}"/>
  <color name="tertiary"    value="{c['tertiary']}"/>
  <color name="sec_bg"      value="{c['secondary_container']}"/>
  <color name="sec_fg"      value="{c['on_secondary_container']}"/>
  <color name="err"         value="{c['error']}"/>
  <color name="err_bg"      value="{c['error_container']}"/>

  <style name="text"                       foreground="fg" background="bg"/>
  <style name="selection"                  foreground="fg_sel" background="bg_sel"/>
  <style name="cursor"                     foreground="primary"/>
  <style name="current-line"               background="bg_cur"/>
  <style name="current-line-number"        foreground="primary" background="bg_cur" bold="true"/>
  <style name="line-numbers"               foreground="fg_dim" background="bg"/>
  <style name="right-margin"               foreground="outline" background="outline"/>
  <style name="bracket-match"              foreground="fg_sel" background="bg_sel" bold="true"/>
  <style name="search-match"               foreground="sec_fg" background="sec_bg"/>

  <style name="def:comment"                foreground="fg_dim" italic="true"/>
  <style name="def:heading"                foreground="primary" bold="true"/>
  <style name="def:keyword"                foreground="primary" bold="true"/>
  <style name="def:statement"              foreground="primary" bold="true"/>
  <style name="def:type"                   foreground="secondary" bold="true"/>
  <style name="def:function"               foreground="primary"/>
  <style name="def:identifier"             foreground="fg"/>
  <style name="def:string"                 foreground="tertiary"/>
  <style name="def:constant"               foreground="tertiary"/>
  <style name="def:number"                 foreground="tertiary"/>
  <style name="def:boolean"                foreground="tertiary" bold="true"/>
  <style name="def:special-char"           foreground="primary"/>
  <style name="def:link-text"              foreground="primary" underline="single"/>
  <style name="def:link-destination"       foreground="tertiary" italic="true"/>
  <style name="def:emphasis"               italic="true" foreground="fg"/>
  <style name="def:strong-emphasis"        bold="true" foreground="fg"/>
  <style name="def:inline-code"            foreground="sec_fg" background="bg_cur"/>
  <style name="def:preformatted-section"   foreground="secondary" background="bg_cur"/>
  <style name="def:list-marker"            foreground="primary" bold="true"/>
  <style name="def:error"                  foreground="err" background="err_bg"/>
</style-scheme>
""")
    if shutil.which("gsettings"):
        subprocess.run(
            ["gsettings", "set", "io.github.celluloid-player.Celluloid", "dark-theme-enable", "true" if mode == "dark" else "false"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )

    # 13) Sync Material Design 3 Expressive SDDM Login Screen (colors, wallpaper & profile avatar!)
    sddm_dir = pathlib.Path("/usr/share/sddm/themes/m3-expressive")
    if sddm_dir.exists():
        try:
            sddm_conf = sddm_dir / "theme.conf"
            if sddm_conf.exists() and os.access(sddm_conf, os.W_OK):
                sddm_keys = [
                    "primary", "on_primary", "primary_container", "on_primary_container",
                    "secondary_container", "on_secondary_container", "tertiary",
                    "surface", "surface_container", "surface_container_high", "surface_container_highest",
                    "on_surface", "on_surface_variant", "outline", "outline_variant",
                    "error", "error_container", "on_error_container",
                ]
                lines = ["[General]", f"mode={mode}", "background=background.jpg", "avatar=avatar.png"]
                for sk in sddm_keys:
                    if sk in c:
                        lines.append(f"{sk}={c[sk]}")
                sddm_conf.write_text("\n".join(lines) + "\n")
            sddm_bg = sddm_dir / "background.jpg"
            if os.access(sddm_bg, os.W_OK) and pathlib.Path(wp).exists():
                shutil.copyfile(wp, sddm_bg)
            sddm_av = sddm_dir / "avatar.png"
            av_src = meta.get("fastfetch_logo") or str(CFG / "fastfetch/kotomi.png")
            if os.access(sddm_av, os.W_OK) and pathlib.Path(av_src).exists():
                shutil.copyfile(av_src, sddm_av)
        except Exception:
            pass

    # 12) Fastfetch portrait logo per profile (Kotomi for violet, Okabe for blue)
    ff_logo = meta.get("fastfetch_logo")
    ff_cfg = CFG / "fastfetch/config.jsonc"
    if ff_logo and pathlib.Path(ff_logo).exists() and ff_cfg.exists():
        old_ff = ff_cfg.read_text()
        new_ff = re.sub(r'("source"\s*:\s*)"[^"]*"', lambda m: f'{m.group(1)}"{ff_logo}"', old_ff, count=1)
        if new_ff != old_ff or meta.get("_refresh_desktop_kitty"):
            ff_cfg.write_text(new_ff)
            # Refresh bottom-right kitty-desktop cleanly so the new portrait renders immediately
            subprocess.run(["pkill", "-f", "kitten panel.*kitty-desktop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(0.15)
            subprocess.run(
                ["niri", "msg", "action", "spawn", "--", str(HOME / ".local/bin/m3-desktop-kitty")],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )

def reload_live_components() -> None:
    # Live reload Kitty
    subprocess.run(["pkill", "-USR1", "-x", "kitty"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # Live reload Waybar
    if subprocess.run(["pgrep", "-x", "waybar"], stdout=subprocess.DEVNULL).returncode == 0:
        subprocess.run(["pkill", "-USR2", "-x", "waybar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # Live reload SwayNC CSS
    if subprocess.run(["pgrep", "-x", "swaync"], stdout=subprocess.DEVNULL).returncode == 0:
        subprocess.run(["swaync-client", "--reload-css"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # Restart SwayOSD cleanly to apply updated CSS
    if subprocess.run(["pgrep", "-x", "swayosd-server"], stdout=subprocess.DEVNULL).returncode == 0:
        subprocess.run(["pkill", "-x", "swayosd-server"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(0.15)
        subprocess.Popen(
            ["swayosd-server", "--top-margin", "0.095", "--duration", "1600"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )


def load_profile(prof_id: str | None) -> dict:
    pid = prof_id or (PROFILE_ACTIVE.read_text().strip() if PROFILE_ACTIVE.exists() else "violet")
    pfile = PROFILE_DIR / f"{pid}.json"
    if pfile.exists():
        return json.loads(pfile.read_text())
    return {
        "id": "violet",
        "name": "Лаванда · Сакура",
        "wallpaper": str(DEFAULT_WP),
        "color_source": "wallpaper",
        "scheme": "scheme-content",
        "mode": "dark",
        "icon_base": "Tela-circle-purple",
        "tg_style": "sakura",
    }


def save_profile(prof: dict) -> None:
    PROFILE_DIR.mkdir(parents=True, exist_ok=True)
    pid = prof.get("id", "violet")
    (PROFILE_DIR / f"{pid}.json").write_text(json.dumps(prof, indent=2, ensure_ascii=False) + "\n")
    PROFILE_ACTIVE.write_text(pid + "\n")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("wallpaper", nargs="?", default=None)
    parser.add_argument("--profile", default=None)
    parser.add_argument("--mode", choices=["dark", "light"], default=None)
    parser.add_argument("--scheme", default=None)
    parser.add_argument("--color-source", default=None)
    parser.add_argument("--icon-base", default=None)
    parser.add_argument("--tg-style", default=None)
    parser.add_argument("--no-wallpaper", action="store_true")
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args()

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    switching_profile = args.profile is not None
    prof = load_profile(args.profile)

    if switching_profile:
        wp = args.wallpaper or prof.get("wallpaper") or str(DEFAULT_WP)
        mode = args.mode or prof.get("mode") or "dark"
        scheme = args.scheme or prof.get("scheme") or "scheme-content"
    else:
        wp = args.wallpaper or prof.get("wallpaper") or (STATE_WP.read_text().strip() if STATE_WP.exists() else str(DEFAULT_WP))
        mode = args.mode or (STATE_MODE.read_text().strip() if STATE_MODE.exists() else prof.get("mode", "dark"))
        scheme = args.scheme or (STATE_SCHEME.read_text().strip() if STATE_SCHEME.exists() else prof.get("scheme", "scheme-content"))

    if not pathlib.Path(wp).exists():
        wp = str(DEFAULT_WP)
    if mode not in ("dark", "light"):
        mode = "dark"

    color_source = args.color_source or prof.get("color_source", "wallpaper")
    icon_base = args.icon_base or prof.get("icon_base", "Tela-circle-purple")
    tg_style = args.tg_style or prof.get("tg_style", "sakura")

    # Persist any per-profile updates (e.g. user picked new wallpaper/mode/scheme while on this profile!)
    prof["wallpaper"] = wp
    prof["mode"] = mode
    prof["scheme"] = scheme
    prof["color_source"] = color_source
    prof["icon_base"] = icon_base
    prof["tg_style"] = tg_style
    save_profile(prof)

    prev_mode = STATE_MODE.read_text().strip() if STATE_MODE.exists() else ""
    prof["_refresh_desktop_kitty"] = (prev_mode != mode or switching_profile)
    STATE_WP.write_text(wp + "\n")
    STATE_MODE.write_text(mode + "\n")
    STATE_SCHEME.write_text(scheme + "\n")

    if not args.no_wallpaper:
        ensure_awww_and_set(wp)

    palette = extract_palette(wp, mode, scheme, color_source=color_source)
    p_ovr = (prof.get("palette_overrides") or {}).get(mode) or {}
    palette.update(p_ovr)
    write_all_configs(wp, mode, scheme, palette, meta=prof)
    reload_live_components()

    if not args.silent and shutil.which("notify-send"):
        mode_ru = "Тёмная" if mode == "dark" else "Светлая"
        subprocess.run(
            [
                "notify-send",
                "-a",
                "Material 3 Expressive",
                "-i",
                "preferences-desktop-theme",
                f"Профиль: {prof.get('name', prof.get('id'))} ({mode_ru})",
                f"Обои: {pathlib.Path(wp).name} · Иконки: {icon_base}",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


if __name__ == "__main__":
    main()
